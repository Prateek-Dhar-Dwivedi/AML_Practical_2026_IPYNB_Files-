atify=y\n)","metadata":{"id":"YTRSIYeTz3du","trusted":true,"execution":{"iopub.status.busy":"2026-10-23T09:31:33.018203Z","iopub.execute_input":"2026-10-23T09:31:33.018649Z","iopub.status.idle":"2026-10-23T09:31:33.066188Z","shell.execute_reply.started":"2026-10-23T09:31:33.018624Z","shell.execute_reply":"2026-10-23T09:31:33.065451Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Fit Gaussian Naive Bayes\nmodel = GaussianNB()\nmodel.fit(X_train, y_train)","metadata":{"id":"HmVeQReFz47X","trusted":true,"execution":{"iopub.status.busy":"2026-10-23T09:31:33.067151Z","iopub.execute_input":"2026-10-23T09:31:33.067387Z","iopub.status.idle":"2026-10-23T09:31:33.083623Z","shell.execute_reply.started":"2026-10-23T09:31:33.067366Z","shell.execute_reply":"2026-10-23T09:31:33.082918Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Predict on the test set and compute accuracy\ny_pred = model.predict(X_test)\naccuracy = accuracy_score(y_test, y_pred)\n\nprint(f\"Test accuracy: {accuracy:.4f}\")","metadata":{"id":"C7LePm9jz7yV","trusted":true,"execution":{"iopub.status.busy":"2026-10-23T09:31:33.085446Z","iopub.execute_input":"2026-10-23T09:31:33.086025Z","iopub.status.idle":"2026-10-23T09:31:33.100524Z","shell.execute_reply.started":"2026-10-23T09:31:33.086Z","shell.execute_reply":"2026-10-23T09:31:33.099694Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"#Using Cross Validation to understand the actual accuracy of the model\n\ncv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\nscores = cross_val_score(GaussianNB(), X, y, cv=cv, scoring=\"accuracy\")\n\nprint(\"Accuracy per fold:\", scores.round(4))\nprint(f\"Mean accuracy : {scores.mean():.4f}\")\nprint(f\"Std deviation : {scores.std():.4f}\")\nprint(f\"Best fold accuracy     : {scores.max():.4f}\")\nprint(f\"Worst fold accuracy   : {scores.min():.4f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-23T09:31:33.101627Z","iopub.execute_input":"2026-10-23T09:31:33.102391Z","iopub.status.idle":"2026-10-23T09:31:33.130716Z","shell.execute_reply.started":"2026-10-23T09:31:33.102365Z","shell.execute_reply":"2026-10-23T09:31:33.129923Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"**Why Cross-Validation?** \n\nA **single train/test split** gives just **one accuracy (~93.71%)**, and it depends on which **rows landed in the test set**. **With 5-fold stratified CV**, the model is trained and tested **five times**, so every sample is tested exactly once.\n\n**What we learned**: **accuracy varies** from **90.35% to 96.49%** across folds, with a mean of **93.85% (±2.35%)**. **CV is worth** using because it:\n\n* Avoids relying on one lucky or unlucky split\n* Makes full use of a small dataset (569 samples)\n* Gives both an average performance and a measure of stability","metadata":{}},{"cell_type":"markdown","source":"> Therefore the **accuracy** of the held-out **test set** is **0.9385 (93%)**","metadata":{}}]}